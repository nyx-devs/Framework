# =============================================================================
# Ro-School framework — copy to .env.local and fill in your values
# NEVER commit .env.local or real secrets to GitHub
# =============================================================================

# --- School branding (public) ---
NEXT_PUBLIC_SCHOOL_NAME=Your Ro-School Name
NEXT_PUBLIC_SCHOOL_SHORT_NAME=YourSchool
NEXT_PUBLIC_SCHOOL_TAGLINE=Primary learning community on Roblox
NEXT_PUBLIC_SCHOOL_MOTTO=Learning · Kindness · Community
NEXT_PUBLIC_SCHOOL_DESCRIPTION=Official website for your Roblox Ro-School.
NEXT_PUBLIC_SCHOOL_RP_NOTICE=This is a Roblox-based learning community. It is not a registered educational institution.
NEXT_PUBLIC_SCHOOL_ADDRESS=Your School Name|Roblox learning community|United Kingdom

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_INVITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_ROBLOX_EXPERIENCE_URL=
NEXT_PUBLIC_ROBLOX_GROUP_URL=

# Optional session labels
NEXT_PUBLIC_SESSION_TITLE=Daily school session
NEXT_PUBLIC_SESSION_DESCRIPTION=School is in session every day from 7:15 pm to 8:40 pm GMT.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key
# Server only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional direct DB URL for migrations
DATABASE_URL=

# --- Admin panel (server only) ---
SCHOOL_ADMIN_PASSWORD=
SCHOOL_ADMIN_EMAILS=you@example.com
ADMIN_SESSION_SECRET=generate_a_long_random_string

# Legacy aliases (optional — some older code paths)
BLUEBIRD_ADMIN_PASSWORD=
BLUEBIRD_ADMIN_EMAILS=

# --- Discord (server only) ---
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_APPLY_CHANNEL_ID=
DISCORD_DECISIONS_CHANNEL_ID=
DISCORD_DATABASE_CHANNEL_ID=
DISCORD_HT_REVIEW_CHANNEL_ID=

# --- Roblox (server only) ---
ROBLOX_OPEN_CLOUD_API_KEY=
ROBLOX_GROUP_ID=
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
ROBLOX_MERIT_API_KEY=
ROBLOX_HT_ROLE_ID=
